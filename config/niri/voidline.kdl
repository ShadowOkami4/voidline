// Voidline integration for Niri.
// Loaded from config.kdl with:  include "voidline.kdl"
// Everything here is safe to edit; the installer never overwrites your own
// config.kdl, it only adds the include line.

// Gaps, focus ring, input and Voidline's keyboard shortcuts come from
// Voidline Settings.
include "voidline-settings.kdl"

// Start the shell with the session.
spawn-sh-at-startup "sh ~/.config/quickshell/voidline/start.sh"

// Voidline Settings opens as a floating window.
window-rule {
    match title="^Voidline Settings$"
    open-floating true
}
