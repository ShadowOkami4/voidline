[Unit]
Description=Voidline local AI provider
Documentation=https://github.com/ShadowOkami4/voidline
After=graphical-session-pre.target

[Service]
Type=simple
# A launcher or stale client cannot wake inference while Settings has Lyra
# disabled. The user service enforces the resource boundary independently of
# every frontend.
ExecCondition=/usr/bin/jq -e .enabled %h/.config/voidline/assistant-state.json
ExecStart=/usr/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_VULKAN=1
Environment=OLLAMA_IGPU_ENABLE=1
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
OOMPolicy=stop

# The inference engine stays outside Quickshell. Models are loaded on demand
# and their keep-alive is controlled by ai-provider.json.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.ollama

# Deliberately no Install section: Lyra starts this service only on demand.
