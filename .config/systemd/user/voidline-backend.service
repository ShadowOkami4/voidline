[Unit]
Description=Voidline per-user desktop backend
Documentation=https://github.com/ShadowOkami4/voidline
After=graphical-session-pre.target
ConditionPathIsExecutable=/usr/lib/voidline/voidlined

[Service]
Type=simple
ExecStart=/usr/lib/voidline/voidlined
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077

# This unprivileged service intentionally has no Install section. Clients
# activate it on demand and it never receives root permissions.
