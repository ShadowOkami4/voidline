#!/bin/sh
set -eu

# Installation source. The installer must copy this file to
# /usr/lib/voidline/network-secret-helper as root with mode 0755. Never execute
# this user-writable source through pkexec.

[ "$(id -u)" -eq 0 ] || exit 77
ssid=${2:-}
[ "${1:-}" = reveal ] && [ -n "$ssid" ] || exit 2

if command -v nmcli >/dev/null 2>&1 \
        && systemctl is-active --quiet NetworkManager.service 2>/dev/null; then
    for uuid in $(nmcli -t -f UUID,TYPE connection show 2>/dev/null |
            awk -F: '$2 == "802-11-wireless" || $2 == "wifi" { print $1 }'); do
        profile_ssid=$(nmcli -g 802-11-wireless.ssid connection show "$uuid" 2>/dev/null || true)
        [ "$profile_ssid" = "$ssid" ] || continue
        secret=$(nmcli --show-secrets -g 802-11-wireless-security.psk connection show "$uuid" 2>/dev/null || true)
        [ -n "$secret" ] && printf '%s\n' "$secret" && exit 0
    done
fi

for profile in /var/lib/iwd/*.psk; do
    [ -f "$profile" ] || continue
    encoded_name=${profile##*/}
    encoded_name=${encoded_name%.psk}
    decoded_name=$(printf '%b' "$(printf '%s' "$encoded_name" |
        sed 's/=\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')")
    [ "$decoded_name" = "$ssid" ] || continue
    secret=$(sed -n 's/^Passphrase=//p' "$profile" | head -n 1)
    [ -n "$secret" ] || exit 5
    printf '%s\n' "$secret"
    exit 0
done

exit 4
