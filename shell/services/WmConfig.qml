pragma Singleton

import Quickshell
import Quickshell.Io
import QtQuick
import qs.core
import qs.compositor

// Turns the window-manager settings into a config fragment for the compositor
// that is running, and applies it:
//   Hyprland: ~/.config/hypr/voidline-settings.lua  (also evaluated live)
//   Niri:     ~/.config/niri/voidline-settings.kdl  (Niri reloads on change)
// Both files are loaded from the Voidline hook file, after the user's own
// config, so these values win while "managed" is on. Voidline's keyboard
// shortcuts are always written, managed or not.
Singleton {
    id: root

    readonly property string home: Quickshell.env("HOME")
    readonly property string configDir: Quickshell.env("XDG_CONFIG_HOME") || home + "/.config"
    readonly property string wm: Compositor.name
    readonly property string path: wm === "hyprland" ? configDir + "/hypr/voidline-settings.lua"
        : (wm === "niri" ? configDir + "/niri/voidline-settings.kdl" : "")
    readonly property bool managed: Config.desktop.managed

    readonly property var d: Config.desktop
    readonly property string active: String(Theme.primary).substring(0, 7)
    readonly property string inactive: String(Theme.outlineVariant).substring(0, 7)

    // Settings and shortcuts are kept apart: settings can be applied live on
    // Hyprland, changed shortcuts need a config reload.
    readonly property string settings: !Config.loaded ? "" : (wm === "hyprland" ? hyprland() : (wm === "niri" ? niri() : ""))
    readonly property string binds: !Config.loaded ? "" : (wm === "hyprland" ? Keybinds.hyprland() : (wm === "niri" ? Keybinds.niri() : ""))
    readonly property string text: settings.length > 0 ? settings + binds : ""

    function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)) }
    function word(s) { return String(s).replace(/[^A-Za-z0-9_,:+ -]/g, "") }

    // [{ name, mode, scale }] from the saved "name|mode|scale" entries.
    readonly property var displays: Config.displays.map(e => e.split("|"))
        .filter(p => p.length === 3 && /^[\w.-]+$/.test(p[0]) && /^\d+x\d+@[\d.]+$/.test(p[1]) && !isNaN(parseFloat(p[2])))
        .map(p => ({ name: p[0], mode: p[1], scale: parseFloat(p[2]) }))

    // { name: "left" | "right" | "up" | "down" | "mirror" }
    readonly property var places: {
        const out = {}
        for (const e of Config.displayPlaces) {
            const p = e.split("=")
            if (p.length === 2 && /^[\w.-]+$/.test(p[0]) && ["left", "right", "up", "down", "mirror"].includes(p[1])) out[p[0]] = p[1]
        }
        return out
    }
    // The screen the others are placed around.
    readonly property string primary: {
        const names = Compositor.outputs.map(o => o.name)
        return names.find(n => !places[n]) ?? (names[0] ?? "")
    }

    function hyprland() {
        const header = "-- Generated by Voidline Settings. Do not edit: changes are overwritten.\n"
        let monitors = ""
        const where = name => places[name] && places[name] !== "mirror" ? "auto-" + places[name] : "auto"
        const mirror = name => places[name] === "mirror" && primary.length > 0 && primary !== name ? `, mirror = "${primary}"` : ""
        for (const o of displays)
            monitors += `hl.monitor({ output = "${o.name}", mode = "${o.mode}", position = "${where(o.name)}", scale = ${o.scale}${mirror(o.name)} })\n`
        for (const name of Object.keys(places))
            if (!displays.some(o => o.name === name))
                monitors += `hl.monitor({ output = "${name}", mode = "preferred", position = "${where(name)}", scale = "auto"${mirror(name)} })\n`
        if (!managed) return header + monitors
        const h = Config.hyprland
        const gaps = clamp(d.gaps, 0, 60), border = clamp(d.border, 0, 10)
        const general = [
            `gaps_in = ${Math.round(gaps / 2)}`, `gaps_out = ${gaps}`, `border_size = ${border}`,
            `layout = "${["dwindle", "master", "scrolling"].includes(h.layout) ? h.layout : "dwindle"}"`
        ]
        if (d.themedBorders)
            general.push(`col = { active_border = "rgba(${active.substring(1)}ff)", inactive_border = "rgba(${inactive.substring(1)}aa)" }`)
        const input = [
            `follow_mouse = ${d.focusFollowsMouse ? 1 : 2}`,
            `sensitivity = ${clamp(d.pointerSpeed, -1, 1).toFixed(2)}`,
            `touchpad = { natural_scroll = ${d.naturalScroll}, tap_to_click = ${d.tapToClick} }`
        ]
        if (word(d.kbLayout).length > 0) input.unshift(`kb_layout = "${word(d.kbLayout)}"`)
        return header + monitors + "hl.config({\n"
            + `    general = { ${general.join(", ")} },\n`
            + `    decoration = { rounding = ${clamp(d.rounding, 0, 40)}, inactive_opacity = ${h.dimInactive ? "0.88" : "1.0"}, `
            + `blur = { enabled = ${h.blur && !Config.gameMode} }, shadow = { enabled = ${h.shadows && !Config.gameMode} } },\n`
            + `    animations = { enabled = ${d.animations && !Config.gameMode} },\n`
            + `    input = { ${input.join(", ")} },\n`
            + `    misc = { vrr = ${h.vrr ? 1 : 0} },\n`
            + "})\n"
    }

    // Niri cannot switch a flag off from an included file, so flags are only
    // written when they are on.
    function niri() {
        const header = "// Generated by Voidline Settings. Do not edit: changes are overwritten.\n"
        let outputs = ""
        for (const o of displays)
            outputs += `output "${o.name}" {\n    mode "${o.mode}"\n    scale ${o.scale}\n}\n`
        if (!managed) return header + outputs
        const n = Config.niri
        const border = clamp(d.border, 0, 10)
        const center = ["never", "always", "on-overflow"].includes(n.centerColumn) ? n.centerColumn : "never"
        let ring = "        off\n"
        if (border > 0) {
            ring = `        width ${border}\n`
            if (d.themedBorders) ring += `        active-color "${active}"\n        inactive-color "${inactive}"\n`
        }
        let out = header + outputs
            + "layout {\n"
            + `    gaps ${clamp(d.gaps, 0, 60)}\n`
            + `    center-focused-column "${center}"\n`
            + `    default-column-width { proportion ${clamp(n.columnWidth, 0.2, 1).toFixed(2)}; }\n`
            + "    focus-ring {\n" + ring + "    }\n"
            + "}\n"
            + `prefer-no-csd ${n.hideTitleBars}\n`
            + "window-rule {\n"
            + `    geometry-corner-radius ${clamp(d.rounding, 0, 40)}\n`
            + "    clip-to-geometry true\n"
            + "}\n"
        if (!d.animations || Config.gameMode) out += "animations {\n    off\n}\n"
        let input = ""
        if (word(d.kbLayout).length > 0)
            input += `    keyboard {\n        xkb {\n            layout "${word(d.kbLayout)}"\n        }\n    }\n`
        const speed = clamp(d.pointerSpeed, -1, 1).toFixed(2)
        input += `    mouse {\n        accel-speed ${speed}\n    }\n`
        input += `    touchpad {\n        accel-speed ${speed}\n${d.tapToClick ? "        tap\n" : ""}${d.naturalScroll ? "        natural-scroll\n" : ""}    }\n`
        if (d.focusFollowsMouse) input += "    focus-follows-mouse\n"
        return out + "input {\n" + input + "}\n"
    }

    // What is in the file: read once at start, so an unchanged config costs
    // nothing and does not reload the compositor.
    property string written: ""
    property bool primed: false
    onTextChanged: if (text.length > 0) debounce.restart()
    onManagedChanged: if (!managed && wm === "hyprland" && Config.loaded) handBack.restart()

    Timer {
        id: debounce
        interval: 250
        onTriggered: {
            if (root.path.length === 0) return
            if (!root.primed) { root.primed = true; root.written = file.text() }
            if (root.text === root.written) return
            const bindsChanged = !root.written.endsWith(root.binds) || (root.binds.length === 0 && root.written.includes("hl.bind("))
            root.written = root.text
            file.setText(root.text)
            if (root.wm !== "hyprland") return
            // Shortcuts cannot be replaced one by one, so reload the config;
            // plain settings are applied right away without a reload.
            if (bindsChanged) reload.restart()
            else if (root.managed) {
                const lua = root.settings.split("
").filter(l => !l.startsWith("--")).join(" ")
                Quickshell.execDetached(["hyprctl", "eval", lua])
            }
        }
    }
    Timer { id: reload; interval: 150; onTriggered: Quickshell.execDetached(["hyprctl", "reload"]) }

    // Managing switched off on Hyprland: reload so the user's own values return.
    Timer { id: handBack; interval: 600; onTriggered: Quickshell.execDetached(["hyprctl", "reload"]) }

    FileView {
        id: file
        path: root.path
        blockLoading: true
        printErrors: false
    }
}
