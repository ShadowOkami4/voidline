pkgbase = voidline
	pkgdesc = Voidline desktop environment for Hyprland
	pkgver = 0.3.0dev
	pkgrel = 1
	url = https://github.com/ShadowOkami4/voidline
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = rust
	makedepends = pkgconf
	makedepends = gcc
	makedepends = gtk4
	makedepends = vte4
	makedepends = networkmanager
	options = !debug
	source = voidline::git+https://github.com/ShadowOkami4/voidline.git#tag=v0.3.0dev
	sha256sums = SKIP

pkgname = voidline-backend
	pkgdesc = Validated per-user Voidline backend, CLI, and Rust terminal
	depends = glibc
	depends = gtk4
	depends = vte4
	depends = systemd
	depends = polkit
	depends = playerctl
	depends = networkmanager

pkgname = voidline-shell
	pkgdesc = Voidline Quickshell desktop shell and Settings for Hyprland
	depends = voidline-backend
	depends = hyprland
	depends = quickshell
	depends = xdg-desktop-portal-hyprland
	depends = qt6-declarative
	depends = qt6-svg
	depends = qt6-imageformats
	depends = polkit
	depends = networkmanager
	depends = upower
	depends = power-profiles-daemon
	depends = pipewire
	depends = pipewire-pulse
	depends = wireplumber
	depends = bluez
	depends = bluez-utils
	depends = brightnessctl
	depends = playerctl
	depends = jq
	depends = curl
	depends = wl-clipboard
	depends = cliphist
	depends = grim
	depends = slurp
	depends = libnotify
	depends = util-linux
	depends = iproute2
	depends = ripgrep
	depends = findutils
	depends = file
	depends = xdg-utils
	depends = xdg-user-dirs
	depends = glib2
	depends = ttf-material-symbols-variable
	optdepends = ttf-roboto-flex: complete Voidline typography
	optdepends = papirus-icon-theme: application icon fallback
	optdepends = noto-fonts: fallback text font
	optdepends = xdg-desktop-portal-gtk: file chooser portal
	optdepends = imagemagick: profile picture cropping
	optdepends = pacman-contrib: update checks
	optdepends = qrencode: Wi-Fi and hotspot QR codes
	optdepends = hyprsunset: night light
	optdepends = lm_sensors: temperature readings
	optdepends = hostapd: mobile hotspot
	optdepends = ddcutil: brightness control for compatible external displays
	optdepends = wf-recorder: screen recording
	optdepends = hyprpicker: color picker
	optdepends = cups: printer discovery and management
	optdepends = sane-airscan: network scanner discovery
	optdepends = voidline-ai: Lyra — Extreme Beta
	optdepends = voidline-sddm: matching login theme

pkgname = voidline-ai
	pkgdesc = Optional Lyra local assistant integration (Extreme Beta)
	depends = voidline-shell
	depends = jq
	depends = ollama

pkgname = voidline-sddm
	pkgdesc = Lightweight SDDM theme matching the Voidline lock screen
	depends = sddm
	depends = qt6-declarative
